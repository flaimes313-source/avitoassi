# ============================================================
# TELEGRAM BOT
# ============================================================
# Токен, полученный от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAA-your-token-here

# Telegram ID главного администратора (ваш личный ID)
# Узнать можно у @userinfobot
ADMIN_TELEGRAM_ID=123456789

# ============================================================
# WEBHOOK / BOTHOST
# ============================================================
# Публичный URL, который выдаст BotHost после первого деплоя
# На локальной разработке не используется (long polling)
WEBHOOK_BASE_URL=https://your-app.bothost.ru
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-to-random-string

# Режим работы: polling (локально) / webhook (на BotHost)
BOT_MODE=polling

# ============================================================
# POSTGRESQL (BotHost предоставит строку подключения)
# ============================================================
# Формат: postgresql://user:password@host:port/dbname
# На BotHost берётся из переменных окружения платформы
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/avito_bot

# ============================================================
# YANDEX CLOUD (YandexGPT + Vision OCR)
# ============================================================
# OAuth-токен или IAM-токен сервисного аккаунта
YANDEX_API_KEY=your-yandex-api-key
# ID каталога в Yandex Cloud (обязателен для GPT)
YANDEX_FOLDER_ID=b1gxxxxxxxxxxxxxxxxx
# Модель: yandexgpt-lite / yandexgpt / yandexgpt-pro
YANDEX_GPT_MODEL=yandexgpt
# Температура генерации (0.0–1.0). 0.6 — баланс креатива и точности
YANDEX_GPT_TEMPERATURE=0.6
# Максимум токенов в ответе
YANDEX_GPT_MAX_TOKENS=2000

# Включает анализ изображений (Vision). Если модель недоступна — false
IMAGE_ANALYSIS_ENABLED=true

# ============================================================
# YOOKASSA (тестовый магазин)
# ============================================================
YOOKASSA_SHOP_ID=your-test-shop-id
YOOKASSA_SECRET_KEY=test_your-secret-key
# URL возврата после оплаты (можно тот же, что WEBHOOK_BASE_URL)
YOOKASSA_RETURN_URL=https://t.me/your_bot_username

# ============================================================
# ТАРИФЫ И ЛИМИТЫ (настраиваемые — блок 11 ТЗ)
# ============================================================
# Free: задач в календарный месяц
FREE_MONTHLY_TASKS=3
# PRO: задач в календарный день
PRO_DAILY_TASKS=5
# PRO: цена в рублях
PRO_PRICE_RUB=490
# PRO: срок подписки в днях
PRO_DURATION_DAYS=30

# ============================================================
# ПРИВАТНОСТЬ И ФАЙЛЫ
# ============================================================
# Сколько часов хранить оригиналы фото (блок 13 ТЗ)
PHOTO_RETENTION_HOURS=24
# Максимальный размер одного фото в МБ
MAX_PHOTO_SIZE_MB=10

# ============================================================
# ОБЩИЕ НАСТРОЙКИ
# ============================================================
# Часовой пояс по умолчанию (пока пользователь не выбрал свой)
DEFAULT_TIMEZONE=Europe/Moscow
# Уровень логов: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# Окружение: dev / prod
ENVIRONMENT=dev