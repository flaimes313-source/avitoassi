# ============================================================
# TELEGRAM BOT
# ============================================================
TELEGRAM_BOT_TOKEN=123456789:AAA-your-token-here
ADMIN_TELEGRAM_ID=123456789

# ============================================================
# WEBHOOK / BOTHOST
# ============================================================
WEBHOOK_BASE_URL=https://your-app.bothost.ru
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-to-random-string
BOT_MODE=polling

# ============================================================
# POSTGRESQL (BotHost предоставит строку подключения)
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/avito_bot

# ============================================================
# GIGACHAT (основная нейросеть)
# ============================================================
# Ключ авторизации из личного кабинета developers.sber.ru
# (base64-encoded client_id:client_secret)
GIGACHAT_CREDENTIALS=your-authorization-key-here
# Scope: GIGACHAT_API_PERS (физлица) / GIGACHAT_API_B2B / GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель: GigaChat, GigaChat-Pro, GigaChat-Max, GigaChat-3-Ultra
GIGACHAT_MODEL=GigaChat
# Температура генерации (0.0–1.0)
GIGACHAT_TEMPERATURE=0.6
# Максимум токенов в ответе
GIGACHAT_MAX_TOKENS=2000
# Отключение проверки SSL (для dev; на prod лучше указать ca_bundle_file)
GIGACHAT_VERIFY_SSL=false
# Путь к файлу CA-сертификата (опционально, для продакшена)
GIGACHAT_CA_BUNDLE_FILE=

# ============================================================
# YANDEX CLOUD (fallback, если GigaChat недоступен)
# ============================================================
YANDEX_API_KEY=your-yandex-api-key
YANDEX_FOLDER_ID=b1gxxxxxxxxxxxxxxxxx
YANDEX_GPT_MODEL=yandexgpt
YANDEX_GPT_TEMPERATURE=0.6
YANDEX_GPT_MAX_TOKENS=2000

# Включает анализ изображений (Vision). Если модель недоступна — false
IMAGE_ANALYSIS_ENABLED=true

# ============================================================
# YOOKASSA (тестовый магазин)
# ============================================================
YOOKASSA_SHOP_ID=your-test-shop-id
YOOKASSA_SECRET_KEY=test_your-secret-key
YOOKASSA_RETURN_URL=https://t.me/your_bot_username

# ============================================================
# ТАРИФЫ И ЛИМИТЫ
# ============================================================
FREE_MONTHLY_TASKS=3
PRO_DAILY_TASKS=5
PRO_PRICE_RUB=490
PRO_DURATION_DAYS=30

# ============================================================
# ПРИВАТНОСТЬ И ФАЙЛЫ
# ============================================================
PHOTO_RETENTION_HOURS=24
MAX_PHOTO_SIZE_MB=10

# ============================================================
# ОБЩИЕ НАСТРОЙКИ
# ============================================================
DEFAULT_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
ENVIRONMENT=dev